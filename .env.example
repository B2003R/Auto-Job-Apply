# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# OpenAI: powers form verification and repair only, never job matching.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a vision-capable model: the verifier sends a screenshot alongside the
# extracted form snapshot. Override freely as newer models ship.
OPENAI_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Browser. The profile directory MUST NOT be your default Chrome profile:
# Chrome 136+ silently ignores --remote-debugging-port on the default profile.
# `npm run setup:browser` creates and provisions this directory for you.
# ---------------------------------------------------------------------------
CHROME_PROFILE_DIR=./.browser-profile
CHROME_DEBUG_PORT=9222
# Leave blank to auto-detect the installed Chrome for your platform.
CHROME_PATH=

# ---------------------------------------------------------------------------
# Identity used when an ATS forces account creation. This mailbox must be the
# one already logged in inside the agent's Chrome profile, because email
# verification is done by reading the webmail tab rather than over IMAP.
# ---------------------------------------------------------------------------
APPLICATION_EMAIL=you@example.com
WEBMAIL_PROVIDER=gmail

# ---------------------------------------------------------------------------
# Credential vault for ATS accounts the agent creates.
# Generate with: openssl rand -base64 32
# Losing this key means losing access to stored ATS passwords.
# ---------------------------------------------------------------------------
VAULT_KEY=

# ---------------------------------------------------------------------------
# Optional: POST a JSON payload here when a job needs a human (CAPTCHA, 2FA).
# Works with Slack or Discord incoming webhooks.
# ---------------------------------------------------------------------------
NOTIFY_WEBHOOK=
