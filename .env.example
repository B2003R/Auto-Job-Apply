# Chrome and extension
CHROME_EXECUTABLE=/usr/bin/google-chrome
CHROME_PROFILE_PATH=/home/user/.config/job-apply-chrome
JOBRIGHT_EXTENSION_ID=your-extension-id-here
# Native toolbar-click tier: 0 means "not calibrated", and the tier refuses to
# click until real coordinates are measured with scripts/calibrate_toolbar.py.
TOOLBAR_X=0
TOOLBAR_Y=0
# Window the native tier activates and verifies before clicking. Set
# CHROME_WINDOW_ID (xdotool search --name "Google Chrome") when more than one
# window matches the name.
CHROME_WINDOW_NAME=Google Chrome
CHROME_WINDOW_ID=

# Storage
SQLITE_PATH=./data/jobs.db
ARTIFACTS_PATH=./data/artifacts

# Control plane. The API can submit applications in your name, so it binds
# loopback and refuses to bind anywhere wider without a token. Set API_TOKEN
# before changing API_HOST; the server exits with the reason if you do not.
API_HOST=127.0.0.1
API_PORT=8765
API_TOKEN=
# Recorded as the approver in the audit trail. Empty means a fingerprint of
# the token is recorded instead, which names the credential without ever
# writing the secret down.
API_ACTOR=
# Seconds the worker waits before looking for new queue items when nothing
# has woken it. Queueing through the API wakes it immediately.
WORKER_POLL_INTERVAL_S=2.0

# Safety defaults (do not enable without explicit approval workflow review)
AUTO_SUBMIT=false
LOG_FIELD_VALUES=false

# Board rate caps (UTC day, no runtime bypass)
LINKEDIN_DAILY_CAP=40
JOBRIGHT_DAILY_CAP=40
WELLFOUND_DAILY_CAP=40
HANDSHAKE_DAILY_CAP=40

# Humanization delays (milliseconds)
DELAY_MIN_MS=500
DELAY_MAX_MS=1500

# Canonical answers the applicant wrote themselves. Consulted before any
# model; see answers.example.yaml for the format. A missing file is allowed
# and simply means every gap needs a model or a human.
ANSWERS_PATH=./answers.yaml

# Model routing. Leaving OPENAI_API_KEY empty is supported: no request is
# ever made and every free-text gap is routed to the approval gate instead.
ROUTINE_MODEL_URL=https://api.openai.com/v1
ROUTINE_MODEL_NAME=gpt-4o-mini
ESCALATION_MODEL_URL=https://api.openai.com/v1
ESCALATION_MODEL_NAME=gpt-4o
OPENAI_API_KEY=
MODEL_TIMEOUT_S=30
MODEL_MAX_OUTPUT_TOKENS=400

# Token pricing (USD per 1M tokens). Parsed as exact decimals, not floats.
ROUTINE_INPUT_PRICE=0.15
ROUTINE_OUTPUT_PRICE=0.60
ESCALATION_INPUT_PRICE=2.50
ESCALATION_OUTPUT_PRICE=10.00
