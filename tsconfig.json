{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is needed because page.evaluate callbacks are typechecked as browser code.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    // The project runs directly on Node's type stripping rather than a bundler,
    // which requires explicit .ts import extensions. The rewrite flag keeps
    // `tsc` emit working anyway. erasableSyntaxOnly makes tsc reject syntax Node
    // cannot strip (enums, namespaces, parameter properties) instead of letting
    // it fail at run time.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
