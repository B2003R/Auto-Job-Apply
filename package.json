{
  "name": "auto-job-apply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous job application agent that drives a real Chrome profile with the Jobright autofill extension",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/index.ts",
    "setup:browser": "npm run agent -- setup:browser",
    "collect": "npm run agent -- collect",
    "run:dry": "npm run agent -- run --mode dry-run",
    "run:review": "npm run agent -- run --mode review",
    "run:auto": "npm run agent -- run --mode auto",
    "export": "npm run agent -- export",
    "status": "npm run agent -- status",
    "vault:export": "npm run agent -- vault:export",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'src/**/*.test.ts'",
    "test:browser": "xvfb-run -a npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "openai": "^6.9.0",
    "playwright": "^1.56.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  }
}
