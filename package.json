{
  "name": "auto-job-apply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous job application agent that drives a real Chrome profile with the Jobright autofill extension",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "tsx src/index.ts",
    "setup:browser": "tsx src/index.ts setup:browser",
    "collect": "tsx src/index.ts collect",
    "run:dry": "tsx src/index.ts run --mode dry-run",
    "run:review": "tsx src/index.ts run --mode review",
    "run:auto": "tsx src/index.ts run --mode auto",
    "export": "tsx src/index.ts export",
    "status": "tsx src/index.ts status",
    "vault:export": "tsx src/index.ts vault:export",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "openai": "^6.9.0",
    "playwright": "^1.56.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
